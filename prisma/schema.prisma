// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  HAIR       
  ESTHETICS
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Int      // current price in cents
  duration    Int      // current durationin minutes
  category    Category
  active      Boolean  @default(true)
  overlap     Boolean  @default(false) // New field to indicate if the service can overlap with others
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  appointments    ScheduledService[]
  professionals   ProfessionalService[]
}

model Client {
  id             String   @id @default(uuid())
  fullName       String
  whatsapp       String?  @unique
  profileImage   String?
  technicalNotes String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  appointments   Appointment[]
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Appointment  {
  id        String        @id @default(uuid())
  clientId  String
  price Int      // price of the entire appointment (in cents)
  date      DateTime // Datetime of the appointment to save query performance, but we will also have startTime and endTime in ScheduledService for more precise scheduling 
  status    AppointmentStatus @default(PENDING)
  observations String?    @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relationships
  client    Client  @relation(fields: [clientId], references: [id])
  services  ScheduledService[]
  payments  Payment[]
}

model ScheduledService {  
  id             String   @id @default(uuid())
  startTime      DateTime // Scheduled start time for this service
  endTime        DateTime // Scheduled end time for this service
  price          Int      // Price for this specific service (in cents)
  // Link back to the service template
  serviceId      String
  service        Service  @relation(fields: [serviceId], references: [id])
  // Link to the professional doing the work
  professionalId String 
  professional   Professional @relation(fields: [professionalId], references: [id])
  // Each service belongs to exactly ONE master appointment, but an appointment can have multiple services
  appointmentId  String
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ProfessionalSchedule {
  id              String    @id @default(uuid())
  professionalId  String
  dayOfWeek       Int       // 0-6 (Monday-Sunday)
  startTime       String    // "09:00"
  endTime         String    // "18:00"
  isAvailable     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships
  professional    Professional @relation(fields: [professionalId], references: [id])

  @@unique([professionalId, dayOfWeek])
}

model Professional {
  id             String   @id @default(uuid())
  fullName       String
  whatsapp       String   @unique
  bio            String?
  profileImage   String?
  category       Category
  active         Boolean  @default(true)
  rating         Float?   // Average rating from client reviews
  commissionRate Int // Commission rate as a percentage (e.g., 20 for 20%)
  commissionType String   // "FIXED" or "PERCENTAGE"

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  appointments    ScheduledService[]
  schedules       ProfessionalSchedule[]
  leaves          ProfessionalLeave[]
  services        ProfessionalService[]

  // 🔐 Ligação com a tabela de autenticação
  userId      String   @unique // @unique garante que é uma relação 1 para 1
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfessionalLeave {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  startDate      DateTime     // Use DateTime to handle multi-day vacations
  endDate        DateTime     
  
  // Optional: For partial days (e.g., leaving 2 hours early)
  startTime      String?      // "14:00"
  endTime        String?      // "16:00"
  reason         String?      // "Vacation", "Medical"

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

    // Add missing indexes for performance
  @@index([professionalId])
  @@index([startDate, endDate])
}

model ProfessionalService {
  id             String   @id @default(uuid())
  professionalId String
  serviceId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
}

enum PaymentStatus {
  PENDENTE
  PAGO
  PARCIAL
}

enum PaymentMethod {
  DINHEIRO
  CARTAO
  PIX
}

model Payment {
  id        String        @id @default(uuid())
  amount    Int
  method    PaymentMethod @default(DINHEIRO)
  appointmentId String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relationships
  appointment   Appointment       @relation(fields: [appointmentId], references: [id])
}

model BusinessHours {
  id        String   @id @default(uuid())
  dayOfWeek Int      // 0-6 (Mon-Sun)
  startTime String   // "HH:MM"
  endTime   String   // "HH:MM"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek])
}

model BusinessHoliday {
  id          String   @id @default(uuid())
  date        String   // "YYYY-MM-DD"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date])
}

enum Role {
  USER
  ADMIN
  PROFESSIONAL
}

model User {
  id            String    @id @default(cuid())
  fullName      String
  email         String    @unique
  password      String   // bcrypt hash 
  // 2. Altere o tipo para o enum Role e defina o valor padrão
  role          Role      @default(USER) 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  // 🔄 Relação 1:1 com a tabela de Profissional (Opcional, pois nem todo User é profissional)
  professional  Professional?
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}